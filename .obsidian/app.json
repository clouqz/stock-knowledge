{
  "livePreview": true,
  "readableLineLength": true,
  "tabSize": 2,
  "useTab": false,
  "spellcheck": true,
  "autoPairBrackets": true,
  "autoPairMarkdown": true,
  "autoPairSynapseWrapping": true,
  "autoCloseBrackets": true,
  "autoCloseMarkdown": true,
  "foldIndent": true,
  "folding": true,
  "showLineNumber": false,
  "showInlineTitle": true,
  "writeDefaultProperties": true,
  "strictLineBreaks": true,
  "newFileLocation": "current",
  "defaultViewMode": 1,
  "defaultFontSize": 16,
  "appearance": "system",
  "cursorStyle": "line",
  "cursorWidth": 2,
  "highlightSelectionMatches": true,
  "idleTime": 2000,
  "showUnlinkedMentions": true
}